{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "ready on|started server on|Listening on",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/services/branding",
        "http://localhost:3000/services/marketing",
        "http://localhost:3000/services/design",
        "http://localhost:3000/services/events",
        "http://localhost:3000/services/market-research",
        "http://localhost:3000/services/video-podcast",
        "http://localhost:3000/services/marketing-consultancy",
        "http://localhost:3000/services/pr-influencer",
        "http://localhost:3000/services/seo-paid-ads",
        "http://localhost:3000/services/social-media",
        "http://localhost:3000/services/web-development",
        "http://localhost:3000/why-us",
        "http://localhost:3000/contact",
        "http://localhost:3000/privacy-policy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.90 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.90 }],
        "categories:seo": ["error", { "minScore": 0.90 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
